# Local single-user app. Never commit .env or put keys in NEXT_PUBLIC_* variables.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# Choose models available to your account. LLM model must support JSON mode and
# max_completion_tokens; image model must support generation AND editing, returning b64_json.
IMAGE_PROVIDER=openai
IMAGE_MODEL=
IMAGE_API_KEY=
DATABASE_URL=sqlite:///./work/echoloom.db
IMAGE_DIRECTORY=work/portraits
MAX_PROFILE_INPUT_CHARS=5000
MAX_CHAT_CONTEXT_TOKENS=12000
MAX_OUTPUT_TOKENS=1500
IMAGE_REQUESTS_PER_HOUR=6
MAX_IMAGE_BYTES=10485760
API_TIMEOUT_SECONDS=90
# Independent story generation budgets; ordinary chat budgets remain unchanged.
STORY_MAX_OUTPUT_TOKENS=3500
STORY_MAX_CONTEXT_TOKENS=24000
