# Local single-user app. Never commit .env or put keys in NEXT_PUBLIC_* variables.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# Choose models available to your account. LLM model must support JSON mode and
# max_completion_tokens; image model must support generation AND editing, returning b64_json.
IMAGE_PROVIDER=openai
IMAGE_MODEL=
IMAGE_API_KEY=
DATABASE_URL=sqlite:///./work/echoloom.db
IMAGE_DIRECTORY=work/portraits
MAX_PROFILE_INPUT_CHARS=5000
MAX_CHAT_CONTEXT_TOKENS=12000
MAX_OUTPUT_TOKENS=1500
IMAGE_REQUESTS_PER_HOUR=6
MAX_IMAGE_BYTES=10485760
API_TIMEOUT_SECONDS=90
# Independent story generation budgets; ordinary chat budgets remain unchanged.
STORY_MAX_OUTPUT_TOKENS=3500
STORY_MAX_CONTEXT_TOKENS=24000
# Life Companion (optional). Configure an OAuth Web application in Google Cloud.
APP_ORIGIN=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google-calendar/callback
# Keep this ignored key file with your database backup. Never commit it.
CALENDAR_KEY_FILE=work/secrets/calendar.key
# Alternative: supply a Fernet key through a private environment secret.
CALENDAR_ENCRYPTION_KEY=
COMPANION_WORKER_ENABLED=true
# Leave false for the local prototype; the first account owns existing records.
ALLOW_ADDITIONAL_ACCOUNTS=false

# Optional rehearsal memory experiment: install pip install -e ".[memory]".
# Uses LLM_API_KEY and the official OpenAI endpoint; never put keys in frontend env.
MEMORY_ENABLED=false
MEMORY_DIRECTORY=work/memory
MEMORY_LLM_MODEL=gpt-4.1-mini
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_TOP_K=5
MEMORY_CONTEXT_BYTES=3000
MEMORY_TIMEOUT_SECONDS=15
MEMORY_INDEX_BATCH_SIZE=4
